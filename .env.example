# 이 파일을 `.env`로 복사한 뒤 값을 채운다. `.env`는 커밋하지 않는다.

# PostgreSQL (docker-compose의 postgres 서비스와 백엔드가 함께 사용)
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=

# 백엔드가 접속할 DB 호스트와 포트 (로컬 실행은 localhost, full 프로필은 postgres)
DB_HOST=
DB_PORT=

# 개발·테스트 프로필 전용 운영자 계정 (HTTP Basic)
DEV_OPERATOR_USERNAME=
DEV_OPERATOR_PASSWORD=

# full 프로필에서 백엔드·프런트엔드를 노출할 호스트 포트(비우면 8080, 5173)
BACKEND_PORT=
FRONTEND_PORT=

# 업로드한 상품 이미지 저장 경로
IMAGE_STORAGE_DIR=

# 프런트엔드(Vite) 개발 서버가 Basic 헤더에 쓰는 개발용 자격 증명 (위 운영자 계정과 같은 값)
VITE_DEV_USERNAME=
VITE_DEV_PASSWORD=
